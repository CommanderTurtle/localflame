# localflame — example environment. Zero auth: NO API key / NO Authorization.
#
# localflame talks to a self-hosted Firecrawl that accepts unauthenticated
# requests. There are deliberately no credential variables here — everything is
# optional. Copy to `.env` only if you need to override a default.

# Firecrawl base URL, honored by the provider at runtime.
# Default: http://localhost:3002
# FIRECRAWL_API_URL=http://localhost:3002

# Same override, but consumed by ./install.sh for the profile patch's baseURL.
# Default: http://localhost:3002
# LOCALFLAME_BASE_URL=http://localhost:3002

# DeepSeek Harness locations, consumed by ./install.sh.
# Default per-dir below (usually correct).
# DSH_HOME=$HOME/.dsh
# DSH_PROFILE=web