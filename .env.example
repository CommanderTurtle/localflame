# Self-hosted Firecrawl needs no key by default.
# FIRECRAWL_API_URL=http://127.0.0.1:3002
# FIRECRAWL_API_KEY=

# Installer endpoint override (the value is stored in each MCP entry).
# LOCALFLAME_BASE_URL=http://127.0.0.1:3002

# Ephemeral resource-store bounds.
# LOCALFLAME_MAX_RESOURCES=64
# LOCALFLAME_MAX_RESOURCE_BYTES=67108864

# Optional non-default harness roots/profile.
# OMP_HOME=$HOME/.omp/agent
# HERMES_HOME=$HOME/.hermes
# DSH_HOME=$HOME/.dsh
# DSH_PROFILE=all
# DSH_PRESET_ROOT=
